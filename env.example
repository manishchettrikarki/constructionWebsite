# ── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site URL (used for metadata, sitemap, Open Graph) ────────
NEXT_PUBLIC_SITE_URL=

# ── Contact form email notifications (optional) ──────────────
# Without these the form still works: every message is saved to
# Supabase and shown at /admin/messages. These only add an email alert.
#
# 1. Sign up free at https://resend.com (3,000 emails/month, no card).
# 2. Create an API key and paste it below.
# 3. Set CONTACT_NOTIFICATION_EMAIL to the address that should be alerted.
#    On the free tier WITHOUT a verified domain, Resend only delivers to
#    the email address you signed up with — use that one for testing.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=

# Optional. Defaults to "Kallisto Website <onboarding@resend.dev>", which
# works with no setup. Change it only once you have verified a domain in
# Resend, e.g. "Kallisto Website <noreply@kallistoengineering.com>".
CONTACT_NOTIFICATION_FROM=
